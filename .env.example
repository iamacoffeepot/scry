# Copy to `.env` and fill in. `.env` is gitignored.

# Riot API key (https://developer.riotgames.com). Dev keys expire every 24h.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Discord incoming-webhook URL (Server Settings → Integrations → Webhooks).
SCRY_DISCORD_WEBHOOK=https://discord.com/api/webhooks/000000000000000000/xxxxxxxx
